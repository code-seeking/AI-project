# Chat Portal - Production Configuration
# Copy to .env and adjust values

NODE_ENV=production
PORT=3001

# JWT Secret (change in production!)
JWT_SECRET=your-strong-jwt-secret-key-here

# Encryption key (auto-generated if empty, but specify for persistence)
ENCRYPTION_KEY=

# AI Service URL (Ollama default)
AI_SERVICE_URL=http://localhost:11434

# PostgreSQL (optional, falls back to JSON file storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/chat-portal
