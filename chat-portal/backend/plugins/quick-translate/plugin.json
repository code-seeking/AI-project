{
  "id": "quick-translate",
  "name": "快捷翻译",
  "version": "1.0.0",
  "description": "划词翻译，支持中英互译",
  "tools": [
    {
      "name": "translate",
      "description": "翻译文本（自动检测语言，中英互译）",
      "parameters": { "text": "string", "targetLang": "string?" }
    }
  ],
  "triggers": [],
  "permissions": ["network", "storage"],
  "entry": "index.js",
  "configSchema": {
    "defaultTarget": { "type": "string", "label": "默认目标语言", "default": "auto" }
  }
}
